# Local: Postgres local o el mismo Postgres de Railway usado en desarrollo.
# Produccion (Railway): Railway inyecta DATABASE_URL automaticamente al
# vincular el servicio de Postgres (mismo patron que fase1-whatsapp-bot).
DATABASE_URL=postgresql://user:pass@localhost:5432/historia_clinica

# Etapa 3: firma los JWT de login. Generar uno propio, nunca reusar este
# ejemplo (ej: python -c "import secrets; print(secrets.token_hex(32))").
JWT_SECRET_KEY=cambiar-por-un-valor-aleatorio-largo

# Etapa 6: clave de servicio de Alma para /interno/vinculacion (>= 32 caracteres).
# Sin ella esos endpoints responden 503 (funcion apagada).
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
VINCULACION_API_KEY=

# Etapa 7: recuperacion de contrasena por correo (puente HTTPS de Alma).
# Sin estas variables /auth/olvide-clave responde igual pero no envia (aviso en el log).
CORREO_PUENTE_URL=
CORREO_PUENTE_TOKEN=
FRONTEND_URL=https://dentalflow-historia-clinica-frontend-production.up.railway.app
NOMBRE_PRODUCTO=DentalFlow
