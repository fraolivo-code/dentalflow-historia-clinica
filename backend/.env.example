# Local: Postgres local o el mismo Postgres de Railway usado en desarrollo.
# Produccion (Railway): Railway inyecta DATABASE_URL automaticamente al
# vincular el servicio de Postgres (mismo patron que fase1-whatsapp-bot).
DATABASE_URL=postgresql://user:pass@localhost:5432/historia_clinica

# Etapa 3: firma los JWT de login. Generar uno propio, nunca reusar este
# ejemplo (ej: python -c "import secrets; print(secrets.token_hex(32))").
JWT_SECRET_KEY=cambiar-por-un-valor-aleatorio-largo
